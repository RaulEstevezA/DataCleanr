    {
      "description": "accents are ignored",
      "input": "Talleres Ruíz",
      "ignoreLegalForms": false,
      "expected": "talleresruiz"
    },
    {
      "description": "ñ is kept as n",
      "input": "Peña",
      "ignoreLegalForms": false,
      "expected": "pena"
    },
    {
      "description": "dots are removed",
      "input": "Transgrau S.L.",
      "ignoreLegalForms": false,
      "expected": "transgrausl"
    },
    {
      "description": "legal form S.L. is ignored when enabled",
      "input": "Transgrau S.L.",
      "ignoreLegalForms": true,
      "expected": "transgrau"
    },
    {
      "description": "legal form written with spaces (S. L.)",
      "input": "Transgrau S. L.",
      "ignoreLegalForms": true,
      "expected": "transgrau"
    },
    {
      "description": "legal form SL without dots",
      "input": "Trans Grau SL",
      "ignoreLegalForms": true,
      "expected": "transgrau"
    },
    {
      "description": "legal form S.A.",
      "input": "LOGISTICA NORTE S.A.",
      "ignoreLegalForms": true,
      "expected": "logisticanorte"
    },
    {
      "description": "legal form S.L.U.",
      "input": "Frutas Martínez S.L.U.",
      "ignoreLegalForms": true,
      "expected": "frutasmartinez"
    },
    {
      "description": "legal form after a comma (Inc.)",
      "input": "Acme, Inc.",
      "ignoreLegalForms": true,
      "expected": "acme"
    },
    {
      "description": "only trailing legal forms are removed",
      "input": "SA Distribuciones",
      "ignoreLegalForms": true,
      "expected": "sadistribuciones"
    },
    {
      "description": "a value that is only a legal form keeps it",
      "input": "S.L.",
      "ignoreLegalForms": true,
      "expected": "sl"
    },
    {
      "description": "empty value",
      "input": "",
      "ignoreLegalForms": true,
      "expected": ""
    }

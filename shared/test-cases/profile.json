      "profile": {
        "format": "datacleanr-profile",
        "version": 1,
        "name": "Clientes mensuales",
        "steps": [
          {
            "type": "transform",
            "column": "Empresa",
            "transform": "trim"
          },
          {
            "type": "transform",
            "column": "Contacto",
            "transform": "trim"
          },
          {
            "type": "transform",
            "column": "Contacto",
            "transform": "collapseSpaces"
          },
          {
            "type": "transform",
            "column": "Contacto",
            "transform": "titleCase"
          },
          {
            "type": "map",
            "column": "Empresa",
            "mapping": [
              {
                "from": "TRANSGRAU",
                "to": "TransGrau S.L."
              },
              {
                "from": "Trans Grau SL",
                "to": "TransGrau S.L."
              }
            ]
          },
          {
            "type": "phone",
            "column": "Teléfono",
            "defaultCountry": "ES",
            "format": "E164"
          },
          {
            "type": "date",
            "column": "Fecha alta",
            "inputOrder": "DMY",
            "format": "ISO",
            "twoDigitYearLimit": 29
          },
          {
            "type": "amount",
            "column": "Importe",
            "ambiguousDecimal": ",",
            "format": "DOT",
            "twoDecimals": true
          },
          {
            "type": "replace",
            "column": "Email",
            "find": "@x.com",
            "replacement": "@ejemplo.com",
            "wholeCell": false,
            "ignoreCase": true
          },
          {
            "type": "transform",
            "column": "Ciudad",
            "transform": "trim"
          },
          {
            "type": "removeDuplicates",
            "columns": [
              "Empresa",
              "Contacto",
              "Email"
            ],
            "ignoreCaseAndSpaces": false,
            "merge": true
          }
        ]
      },
